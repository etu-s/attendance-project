# =============================================================================
# Production checklist (docs/deployment.md):
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://<central host>
#   LOG_LEVEL=warning (personal data in logs is masked, see Core\Logging)
#   SESSION_SECURE_COOKIE=true, HSTS_MAX_AGE=31536000 once every host is HTTPS
#   QUEUE_CONNECTION=redis, CACHE_STORE=redis, a real MAIL_MAILER
#   php artisan horizon + php artisan schedule:run every minute
#   Never commit a filled .env.
# =============================================================================
APP_NAME="AMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite only. Central DB: database/central.sqlite. Tenant DBs: database/tenants/<uuid>.sqlite
DB_CONNECTION=central
# DB_DATABASE=/absolute/path/to/central.sqlite
# TENANT_DB_DIRECTORY=/absolute/path/to/tenants
DB_BUSY_TIMEOUT=5000

# Hosts that serve the super admin API; tenants are <subdomain>.<central host>
CENTRAL_DOMAINS=localhost,127.0.0.1

# SPA origins allowed to use cookie (Sanctum) authentication
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,*.localhost,*.localhost:5173,127.0.0.1,127.0.0.1:8000

# Sessions stay on the exact host (no SESSION_DOMAIN): a tenant's cookie is never sent to another tenant.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true (cookies only over HTTPS)
SESSION_SECURE_COOKIE=false

# Live Today board over Reverb: set to `reverb` and fill REVERB_* (and the
# VITE_REVERB_* copies the SPA is built with). `log` = off; the board polls.
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Backups (php artisan db:backup); folders older than this are pruned daily
BACKUP_KEEP_DAYS=14
FILESYSTEM_DISK=local

# Redis is required for queues and cache: tenancy tags cache entries per tenant,
# which the file/database cache stores do not support.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# Without Redis (local only): CACHE_STORE=array, CACHE_LIMITER=file, QUEUE_CONNECTION=database
CACHE_LIMITER=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Where the SPA runs, for links in emails (reset password, invitations).
# Workspace links get the subdomain in front: http://acme.localhost:5173
FRONTEND_URL=http://localhost:5173

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ams.test"
MAIL_FROM_NAME="${APP_NAME}"

# Rate limits (per minute)
LOGIN_RATE_LIMIT=5
API_RATE_LIMIT=120
PUNCH_RATE_LIMIT=600
# Exports, recalculations and CSV imports, per user
HEAVY_RATE_LIMIT=10

# Strict-Transport-Security max-age (seconds), sent over HTTPS only; 0 = off
HSTS_MAX_AGE=0

# Dashboard cache (seconds)
REPORTS_DASHBOARD_CACHE_SECONDS=60

# Local development seed accounts (php artisan migrate --seed, APP_ENV=local only)
SEED_SUPER_ADMIN_EMAIL=admin@ams.test
SEED_SUPER_ADMIN_PASSWORD=password
SEED_DEMO_ADMIN_EMAIL=admin@acme.test
SEED_DEMO_ADMIN_PASSWORD=password1

