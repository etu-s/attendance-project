# AMS Docker settings. Copy to docker/.env (never commit it), then from docker/:
#   docker compose up -d --build
# Database paths, Redis, queue/cache drivers and the internal Reverb address are
# fixed in compose.yaml. Every other Laravel setting from the root .env.example
# can be added here.

# -- Where the stack is reached ------------------------------------------------
# Central console: http://localhost:8080   Workspaces: http://<subdomain>.localhost:8080
AMS_HTTP_PORT=8080
AMS_DOMAIN=localhost
AMS_SCHEME=http
# Port browsers use when a TLS proxy sits in front (e.g. 443); defaults to AMS_HTTP_PORT.
# AMS_PUBLIC_PORT=
# Override the derived URLs when the public address differs (e.g. behind a TLS proxy):
# APP_URL=https://example.com
# FRONTEND_URL=https://example.com
# CENTRAL_DOMAINS=example.com
# SANCTUM_STATEFUL_DOMAINS=example.com,*.example.com

# -- Application ---------------------------------------------------------------
APP_NAME="AMS"
# local = demo mode: seeds the super admin and the "acme" demo workspace with data
# and opens the Horizon dashboard. Config is cached at container start either way:
# after editing this file, run `docker compose up -d` to recreate the containers.
# For a real deployment: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning.
APP_ENV=local
APP_DEBUG=false
LOG_LEVEL=info
# Empty = generated on first start and kept on the `data` volume.
APP_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=null
# true once the stack is served over HTTPS
SESSION_SECURE_COOKIE=false
HSTS_MAX_AGE=0

# -- Live Today board (Reverb) -------------------------------------------------
# The key is public (it is built into the SPA). Change the secret for any shared
# or production install. Set BROADCAST_CONNECTION=log and REVERB_APP_KEY= to turn
# the live board off (pages poll instead); rebuild the web image after changing the key.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ams
REVERB_APP_KEY=ams-docker-key
REVERB_APP_SECRET=change-me-reverb-secret

# -- Mail ----------------------------------------------------------------------
# `log` writes emails (password reset, invitations) to the container logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ams.test"
MAIL_FROM_NAME="AMS"
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# -- Backups -------------------------------------------------------------------
BACKUP_KEEP_DAYS=14

# -- Demo accounts (APP_ENV=local only) ----------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@ams.test
SEED_SUPER_ADMIN_PASSWORD=password
SEED_DEMO_ADMIN_EMAIL=admin@acme.test
SEED_DEMO_ADMIN_PASSWORD=password1
